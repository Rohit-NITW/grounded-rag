# demo = download-free lexical/extractive preview; NOT an LLM.
# ollama = real local LLM + neural embeddings; openai = hosted LLM + embeddings.
RAG_PROVIDER=demo
RAG_DATA_DIR=./data
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_CHAT_MODEL=qwen2.5:3b
RAG_EMBED_MODEL=nomic-embed-text
# With RAG_PROVIDER=openai, set models below and add your own API key:
# RAG_CHAT_MODEL=gpt-4.1-mini
# RAG_EMBED_MODEL=text-embedding-3-small
# OPENAI_API_KEY=
# Optional shared access token for /api/*; health and static UI remain public.
# RAG_API_TOKEN=replace-with-a-long-random-value
RAG_CHUNK_WORDS=220
RAG_CHUNK_OVERLAP=40
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
